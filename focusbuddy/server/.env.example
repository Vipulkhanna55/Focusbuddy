# FocusBuddy phone server configuration
# Copy to .env (git-ignored), fill in, then load before starting the server:
#   set -a; . ./.env; set +a; python app.py
# Leave LLM_API_KEY empty to run with built-in coaching lines (no AI, fully offline-capable).

# Any OpenAI-compatible /chat/completions provider (Groq, OpenRouter, Gemini OpenAI-compatible, ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=

# gTTS accent: co.in (Indian English, default), com, co.uk, com.au, ...
TTS_TLD=co.in

# Dashboard + device API port
PORT=5000
