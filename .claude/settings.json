{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 focusbuddy/server/simulate.py:*)",
      "Bash(arduino-cli compile:*)"
    ],
    "ask": [
      "Bash(arduino-cli upload:*)",
      "Bash(esptool:*)",
      "Bash(esptool.py:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(pip install:*)",
      "Bash(pkg install:*)",
      "Bash(adb:*)",
      "Edit(./.mcp.json)",
      "Write(./.mcp.json)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardrails.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
